{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Accounting snapshot age",
      "targets": [{"expr": "resource_elastic_quota_snapshot_age_seconds", "legendFormat": "seconds"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Metrics API health",
      "targets": [{"expr": "resource_elastic_quota_metrics_api_healthy", "legendFormat": "healthy"}],
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Pool limits and budgets",
      "targets": [
        {"expr": "resource_elastic_quota_pool_allocated_limits_memory_bytes", "legendFormat": "{{pool}} limits"},
        {"expr": "resource_elastic_quota_pool_admission_budget_memory_bytes", "legendFormat": "{{pool}} budget"},
        {"expr": "resource_elastic_quota_pool_allocatable_memory_bytes", "legendFormat": "{{pool}} physical"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Department quota and limits",
      "targets": [
        {"expr": "resource_elastic_quota_department_allocated_limits_memory_bytes", "legendFormat": "{{department}}/{{pool}} limits"},
        {"expr": "resource_elastic_quota_department_effective_quota_memory_bytes", "legendFormat": "{{department}}/{{pool}} quota"},
        {"expr": "resource_elastic_quota_department_observed_usage_memory_bytes", "legendFormat": "{{department}}/{{pool}} actual"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9}
    },
    {
      "type": "timeseries",
      "title": "Admission decisions",
      "targets": [{"expr": "sum by (mode, result) (rate(resource_elastic_quota_admission_requests_total[$__rate_interval]))", "legendFormat": "{{mode}} {{result}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}
    },
    {
      "type": "timeseries",
      "title": "Reconcile latency p95",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(resource_elastic_quota_reconcile_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 30,
  "tags": ["kubernetes", "quota", "kgpp34"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Resource Elastic Quota",
  "uid": "resource-elastic-quota",
  "version": 1
}
